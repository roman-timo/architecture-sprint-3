@startuml
title Управление пользователем - Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class User {
  +String name
  +String email
  +Date reg_date
  +List<House> houses
  +void register()
  +void login()
  +void add_address()
  +void remove_address()
}

class Device {
  +String name
  +String type
  +String status
  +void activate()
  +void deactivate()
}

class House {
  +String address
  +List<Device> devices
  +void add_device()
  +void remove_device()
}

User "1" -- "0..*" House : has
House "1" -- "0..*" Device : has

@enduml
