@startuml
title Умный дом - ER Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

entity User {
  * id : UUID
  * name : String
  * email : String
  * regDate : Date
}

entity House {
  * id : UUID
  * address : String
  * user_id : key<User>
}

entity Device {
  * id : UUID
  * name : String
  * type_id : key<DeviceType>
  * serial_num : String
  * status : String
  * house_id : key<House>
}

entity DeviceType {
  * id : UUID
  * type : String
  * telemetry_type : String
}

entity Telemetry {
  * timestamp : DateTime
  * parametertype : String
  * device_id : key<Device>
  * data : JSON
}

entity Video {
  * file_id : String
  * timestamp : DateTime
  * size : Integer
  * device_id : key<Device>
  * path : String
  * file : Object
}


User "1" -- "0..*" House : has
House "1" -- "0..*" Device : has
Device "1" -- "0..*" Telemetry : generates
Device "1" -- "0..*" Video : generates
DeviceType "1" -- "0..*" Device : selected

@enduml